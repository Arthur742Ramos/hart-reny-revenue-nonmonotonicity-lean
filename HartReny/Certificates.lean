theorem certificate₁_nonnegative :
    ∀ r ∈ dualRows certificate₁, 0 ≤ r.1 := by
  norm_num [dualRows, certificate₁]

theorem certificate₁_coefficients :
    ∀ i, weightedCoefficients (dualRows certificate₁) i = objective prior₁ i := by
  intro ⟨⟨i,j⟩,k⟩
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    norm_num [weightedCoefficients, dualRows, certificate₁, constraintRow,
      basis, values, objective, prior₁]

theorem certificate₁_bound :
    weightedBound (dualRows certificate₁) = revenue₁ := by
  norm_num [weightedBound, dualRows, certificate₁, constraintRow, revenue₁]

